<!-- pages/index/index.wxml -->
<bg src="cloud://cloud1-3ge5gomsffe800a7.636c-cloud1-3ge5gomsffe800a7-1373366709/csfc_bg/世界杯.jpg" overlayOpacity="0.3" blur="0" sizeMode="cover" repeat="false" />
<view class="container main-container">

<!-- 美加墨世界杯横幅 -->
<view class="champion-banner">
  <text class="champion-text">⚽ 2026美加墨世界杯 ⚽</text>
  <text class="champion-subtitle">世界杯年，让我们一起为足球狂欢！</text>
</view>

<!-- Part 1: 头部信息区 -->
<view class="welcome-header">
  <block wx:if="{{hasUserInfo}}">
    <image class="welcome-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
    <view class="welcome-text">欢迎回来, {{userInfo.nickname}}</view>
    <!-- 签到按钮 - 只有已评估（身价 >= 50）的用户才显示 -->
    <button wx:if="{{userValue >= 50}}" bindtap="onSignIn" class="sign-in-button">
      <text class="sign-in-icon">📅</text>
      <text class="sign-in-text">每日签到</text>
    </button>
    <!-- 提示语 - 移动到签到按钮正下方 -->
    <view wx:if="{{userValue >= 50}}" class="notice-banner">
      <text class="notice-text">📢 如遇到队名身价未正常显示，请点击最下面退出登录按钮重新登录</text>
    </view>
  </block>
  <block wx:else>
    <image class="welcome-avatar" src="/images/avatar.png" mode="aspectFill"></image>
    <button class="login-prompt-btn" bindtap="handleLogin">点击登录</button>
  </block>
</view>

<!-- 功能按钮列表 -->
<view class="button-group">
  <!-- 新用户显示开始评估按钮 -->
  <button wx:if="{{showSurveyButton}}" class="menu-button primary-btn" bindtap="goToSurvey">  开始评估</button>
  <!-- 已评估用户（身价 >= 50）显示灰色不可用的开始评估按钮 -->
  <button wx:elif="{{userValue >= 50}}" class="menu-button primary-btn disabled" disabled>  已评估</button>
  
  <!-- 身价信息显示区域 - 只有身价 >= 50 的用户才显示 -->
  <view wx:if="{{userValue >= 50}}" class="user-value-display">
    <block wx:if="{{selectedTeam}}">
      <text class="value-label">我的身价</text>
      <text class="value-amount">¥{{userValue}}万</text>
      <text class="team-info">已选择：{{selectedTeamName}}</text>
    </block>
    <block wx:else>
      <text class="value-label">球队信息</text>
      <text class="team-info warning">请立即选择您的球队</text>
    </block>
  </view>
  
  <!-- 签约球队相关按钮 - 只有身价 >= 50 的用户才显示 -->
  <button wx:if="{{userValue >= 50}}" class="menu-button primary-btn" bindtap="goToTeamSignup">  {{selectedTeam ? '更换球队' : '选择球队'}}</button>
  
  <button class="menu-button primary-btn" bindtap="goToRanking">身价排行榜</button>
  <button class="menu-button primary-btn" bindtap="goToTeamStatusPage">各队报名情况</button>
  <button class="menu-button primary-btn" bindtap="goToStandingsPage">查看联赛积分榜</button>
  <button class="menu-button primary-btn" bindtap="goToSchedulePage">查看联赛赛程</button>
  <button class="menu-button primary-btn" bindtap="goToEuropeanStandings">欧洲五大联赛积分榜</button>
  <button class="menu-button primary-btn" bindtap="goToEuropeanSchedule">欧洲五大联赛赛程</button>
  <button class="menu-button primary-btn" bindtap="goToWorldFootball">五大联赛历史数据</button>
  <button class="menu-button primary-btn" bindtap="goToLeagueRecordsPage">bug提交</button>
  
  <button class="menu-button admin-button" bindtap="goToAdminPage">进入管理员页面</button>
  <button wx:if="{{hasUserInfo}}" class="menu-button logout-button" bindtap="logout">退出登录</button>
</view>

<!-- 天气预报按钮 -->
<view class="weather-trigger" bindtap="toggleWeather">
  <text class="weather-trigger-icon">🌤️</text>
</view>

<!-- 每日一文按钮 -->
<view class="daily-article-trigger" bindtap="toggleDailyArticle">
  <text class="daily-article-trigger-icon">📖</text>
</view>

<!-- 小说阅读按钮 -->
<view class="novel-trigger" bindtap="goToNovelShelf">
  <text class="novel-trigger-icon">📚</text>
</view>

<!-- 天气预报侧边弹窗 -->
<view class="weather-mask {{showWeather ? 'show' : ''}}" bindtap="closeWeather"></view>
<view class="weather-drawer {{showWeather ? 'show' : ''}}">
  <view class="weather-drawer-header">
    <text class="weather-drawer-title">📍 常熟市7天天气</text>
    <text class="weather-drawer-close" bindtap="closeWeather">✕</text>
  </view>
  <view wx:if="{{weatherData && weatherData.length > 0}}" class="weather-drawer-content">
    <view wx:for="{{weatherData}}" wx:key="date" class="weather-drawer-item">
      <text class="weather-drawer-date">{{item.dateShort}}</text>
      <text class="weather-drawer-weekday">{{item.weekday}}</text>
      <text class="weather-drawer-emoji">{{item.weatherEmoji}}</text>
      <text class="weather-drawer-temp">{{item.temp_night}}° ~ {{item.temp_day}}°</text>
    </view>
  </view>
  <view wx:else class="weather-drawer-content">
    <text class="weather-drawer-loading">加载天气中...</text>
  </view>
</view>

<!-- 每日一文侧边弹窗 -->
<view class="daily-article-mask {{showDailyArticle ? 'show' : ''}}" bindtap="closeDailyArticle"></view>
<view class="daily-article-drawer {{showDailyArticle ? 'show' : ''}}">
  <view class="daily-article-drawer-header">
    <text class="daily-article-drawer-title">📖 每日一文</text>
    <text class="daily-article-drawer-close" bindtap="closeDailyArticle">✕</text>
  </view>
  <view wx:if="{{dailyArticle}}" class="daily-article-drawer-content">
    <view class="article-title">{{dailyArticle.title}}</view>
    <view class="article-meta">{{dailyArticle.author}}</view>
    <view class="article-content">{{dailyArticle.content}}</view>
  </view>
  <view wx:else class="daily-article-drawer-content">
    <text class="daily-article-drawer-loading">加载中...</text>
  </view>
</view>

<!-- 音乐播放器图标 -->
<view class="music-icon-wrapper {{isMusicPlaying ? 'playing' : ''}}" bindtap="toggleMusic">
  <image class="music-icon" src="/images/music-icon.png" mode="aspectFit" />
</view>

</view>


<!-- Part 3: 登录弹窗 (代码保持不变) -->
<view class="popup-mask" wx:if="{{showLoginPopup}}" bindtap="closeLoginPopup"></view>
<view class="popup-container" wx:if="{{showLoginPopup}}">
<view class="title">授权登录</view>
<view class="subtitle">请设置您的头像和昵称</view>

<view class="avatar-circle">
  <image class="avatar-image" src="{{avatarUrl}}" mode="aspectFill"></image>
  <button 
    class="avatar-btn" 
    open-type="chooseAvatar" 
    bind:chooseavatar="onChooseAvatar"
    bindtap="onAvatarWrapperTap"
    disabled="{{isChoosingAvatar}}"
  ></button>
</view>
<view class="avatar-tip">点击上方选择头像</view>

<view class="nickname-wrapper">
  <input class="nickname-input" type="nickname" placeholder="请输入昵称" value="{{nickname}}" bindinput="onNicknameInput"/>
</view>

<button class="save-button" bindtap="saveNickname">保存并进入</button>
</view>